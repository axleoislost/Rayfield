                                local line = Drawing.new("Line")
                                line.Visible = false
                                line.Thickness = lineThickness
                                line.Transparency = 1
                                tracers[player] = line
                            end
                            local line = tracers[player]
                            local localTeam = Players.LocalPlayer:GetAttribute("TeamID")
                            local playerTeam = player:GetAttribute("TeamID")
                            if localTeam and playerTeam and localTeam == playerTeam then
                                line.Color = Color3.fromRGB(0, 0, 255)
