local UserInputService = game:GetService("UserInputService")
local flightEnabled = false
local flightBoost = 0.2
local flightHeartbeat
local bodyVelocity

local function setupFlightCharacter(character)
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    if flightHeartbeat then flightHeartbeat:Disconnect() end
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end

    flightHeartbeat = runService.Heartbeat:Connect(function()
        if flightEnabled then
            if not bodyVelocity then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                bodyVelocity.Parent = rootPart
            end
            local moveDir = humanoid.MoveDirection
            local vertical = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                vertical = 1
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                vertical = -1
            end
            bodyVelocity.Velocity = (moveDir + Vector3.new(0, vertical, 0)) * flightBoost * 100
        else
            if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
        end
    end)
end

