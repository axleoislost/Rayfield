local shuffledAlphabet = "rUOxPYf2KCZtSWqn5TIvL4dJzNBM36pQXjyDaVRoc9sl7Hk8ebgiEFmGAuw01+/"
    local reverseLookup = {}
    for i = 1, #shuffledAlphabet do
        local c = shuffledAlphabet:sub(i, i)
        reverseLookup[c] = i - 1
    end

    local function base64encode(data)
        local binary = ""
        for i = 1, #data do
            local byte = string.byte(data, i)
            for j = 7, 0, -1 do
                local bit = math.floor(byte / (2 ^ j)) % 2
                binary = binary .. bit
            end
        end

        local padding = (6 - (#binary % 6)) % 6
        binary = binary .. string.rep("0", padding)

        local encoded = ""
        for i = 1, #binary, 6 do
            local chunk = binary:sub(i, i + 5)
            local value = tonumber(chunk, 2)
            encoded = encoded .. shuffledAlphabet:sub(value + 1, value + 1)
        end

        local mod = #data % 3
        if mod > 0 then
            encoded = encoded .. string.rep("=", 3 - mod)
        end

        return encoded
    end

    local originalRequest = (syn and syn.request) or (fluxus and fluxus.request) or (http and http.request) or http_request or request

    requestz = function(params)
        if params.Body then
            params.Body = base64encode(params.Body)
        elseif params.Data then
            params.Data = base64encode(params.Data)
        end
        return originalRequest(params)
    end


