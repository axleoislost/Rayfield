local function isWhitelistedKey(key)
    return WHITELIST[key] == true
end

local function validateKey(key)
    if isWhitelistedKey(key) then return true end
    local success, valid = pcall(function()
        local hwid = gethwid()
        local res = request({
            Url = VALIDATE_URL .. "?key=" .. key .. "&hwid=" .. hwid,
            Method = "GET",
            Headers = { ["User-Agent"] = "Roblox", ["Content-Type"] = "application/json" }
        })
        local data = HttpService:JSONDecode(res.Body)
        return data == "0fg2hn9g9Tfnoiuhf2"
    end)
    return success and valid
end

if isfile(KEY_FILE) then
    local savedKey = readfile(KEY_FILE)
    local valid = validateKey(savedKey)
    if valid then
        continueScript()
        return
    else
        pcall(function() delfile(KEY_FILE) end)
    end
end

