local Camera = workspace.CurrentCamera
RunService.RenderStepped:Connect(function()
    if not Enabled then return end

    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end

    local center = Camera.ViewportSize / 2
    local points = {
        Vector2.new(center.X, center.Y),
        Vector2.new(center.X + OFFSET, center.Y),
        Vector2.new(center.X - OFFSET, center.Y),
        Vector2.new(center.X, center.Y + OFFSET),
        Vector2.new(center.X, center.Y - OFFSET),
    }

    local aimingAtTarget = false
    for _, point in ipairs(points) do
        local ray = Camera:ViewportPointToRay(point.X, point.Y)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, raycastParams)
        if result then
            local character = result.Instance:FindFirstAncestorOfClass("Model")
            local player = Players:GetPlayerFromCharacter(character)
            if player and player ~= LocalPlayer then
                local istarget = false
                local myTeamId = LocalPlayer:GetAttribute("TeamID")
                local otherTeamId = player:GetAttribute("TeamID")
                if myTeamId ~= nil and otherTeamId ~= nil then
                    istarget = (otherTeamId ~= myTeamId)
                else
                    istarget = true
                end
                if istarget then
                    aimingAtTarget = true
                    break
                end
            end
        end
    end

    dot.BackgroundColor3 = aimingAtTarget and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)

    if aimingAtTarget then
        if ClickMode == "Hold" then
            if not holdingMouse then
                mouse1press()
                holdingMouse = true
            end
        elseif ClickMode == "Spam" then
            if tick() - lastSpam > SPAM_DELAY then
                mouse1press()
                mouse1release()
                lastSpam = tick()
            end
        end
    else
        if holdingMouse then
            mouse1release()
            holdingMouse = false
        end
    end
end)

